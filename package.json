{
  "name": "pr-readiness-coach",
  "version": "1.0.0",
  "description": "AI coach that checks branch readiness before you open a pull request",
  "type": "module",
  "bin": {
    "pr-ready": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./core/*": "./dist/core/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "cdk": "cdk -a 'npx tsx infra/bin/app.ts'",
    "deploy": "npm run build && cdk -a 'npx tsx infra/bin/app.ts' deploy --require-approval never -c enableDynamo=true",
    "synth": "cdk -a 'npx tsx infra/bin/app.ts' synth -c enableDynamo=true",
    "web:build": "npm ci --prefix web && npm run build --prefix web",
    "deploy:amplify": "./scripts/deploy-amplify.sh",
    "pr-ready": "tsx src/cli/index.ts",
    "hook": "tsx src/hook/kiro-hook.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jajera/pr-readiness-coach.git"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0",
    "@aws-sdk/client-dynamodb": "^3.1085.0",
    "@aws-sdk/lib-dynamodb": "^3.1098.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "^2.1130.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
